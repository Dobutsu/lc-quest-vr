<Project>

    <!-- The .NET tools (HarmonyBaker, AssemblyRenamer, ShimMaker) are referenced exe projects: the SDK brings along
         their apphosts, deps.json and runtimeconfig.json, once per runtime id, which publishing refuses as duplicates.
         The builder runs the tools inside its own process (ToolHost), so none of these files are needed. -->
    <Target Name="LCQuestDropToolHostFiles" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <_LCQuestToolHostFile Include="@(ResolvedFileToPublish)"
                Condition="'%(ResolvedFileToPublish.RelativePath)' == 'HarmonyBaker' or '%(ResolvedFileToPublish.RelativePath)' == 'HarmonyBaker.exe'
                           or '%(ResolvedFileToPublish.RelativePath)' == 'HarmonyBaker.deps.json' or '%(ResolvedFileToPublish.RelativePath)' == 'HarmonyBaker.runtimeconfig.json'
                           or '%(ResolvedFileToPublish.RelativePath)' == 'AssemblyRenamer' or '%(ResolvedFileToPublish.RelativePath)' == 'AssemblyRenamer.exe'
                           or '%(ResolvedFileToPublish.RelativePath)' == 'AssemblyRenamer.deps.json' or '%(ResolvedFileToPublish.RelativePath)' == 'AssemblyRenamer.runtimeconfig.json'
                           or '%(ResolvedFileToPublish.RelativePath)' == 'ShimMaker' or '%(ResolvedFileToPublish.RelativePath)' == 'ShimMaker.exe'
                           or '%(ResolvedFileToPublish.RelativePath)' == 'ShimMaker.deps.json' or '%(ResolvedFileToPublish.RelativePath)' == 'ShimMaker.runtimeconfig.json'" />
            <ResolvedFileToPublish Remove="@(_LCQuestToolHostFile)" />
        </ItemGroup>
    </Target>

</Project>
