+    private static void OnlyLocal()
+    {
+        var online = GameObject.Find("Online")?.transform as RectTransform;
+        var local = GameObject.Find("LAN")?.transform as RectTransform;
+        if (online == null || local == null)
+            return;
+
+        online.gameObject.SetActive(false);
+        local.anchoredPosition = new Vector2((online.anchoredPosition.x + local.anchoredPosition.x) / 2, local.anchoredPosition.y);
+    }
